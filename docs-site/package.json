{
  "name": "praxis-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "security:audit": "node ./scripts/audit-security.mjs",
    "start": "npm run build && npm run serve",
    "build": "node scripts/build-reader.mjs",
    "check": "npm run build && node scripts/check-links.mjs",
    "serve": "node scripts/serve-reader.mjs",
    "check:reader": "node scripts/check-reader.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "markdown-it": "14.3.3",
    "prismjs": "1.30.0"
  },
  "overrides": {
    "markdown-it": "$markdown-it"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0"
  }
}
